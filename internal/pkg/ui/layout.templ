package ui

import "github.com/yogasw/wick/internal/pkg/spa"

templ Layout(title string) {
	{{ theme := ThemeByID(ThemeFromContext(ctx)) }}
	<!DOCTYPE html>
	<html lang="en" class={ htmlThemeClasses(theme) } { htmlScaleAttrs(ctx)... }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content"/>
			<title>{ title } | { AppNameFromContext(ctx) }</title>
			<link rel="stylesheet" href="/public/css/app.css"/>
			<!-- PWA manifest + icons. Install-to-home works on Chrome/Android
			     and iOS Safari 16+; older iOS keeps the default web-clip icon. -->
			<link rel="manifest" href="/public/manifest.json"/>
			<link rel="icon" type="image/svg+xml" href="/public/img/icon.svg"/>
			<link rel="apple-touch-icon" href="/public/img/icon-192.png"/>
			<!-- Neutral dark default; the sync script below overwrites this
			     with the active theme's real surface colour before paint. -->
			<meta name="theme-color" content="#142638"/>
			<!-- mobile-web-app-capable is the standard name; the apple- one is
			     kept because iOS Safari still only honours the prefixed form.
			     Chrome warns when the prefixed tag appears alone. -->
			<meta name="mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
			<meta name="apple-mobile-web-app-title" content={ AppNameFromContext(ctx) }/>
			if theme.ID == "" {
				<!-- No user preference: follow device prefers-color-scheme before first paint. -->
				<script>
					(function(){var h=document.documentElement;if(window.matchMedia('(prefers-color-scheme:dark)').matches){h.classList.add('theme-dark','dark')}else{h.classList.add('theme-light')}})()
				</script>
			}
			<!-- PWA status-bar tint. The <meta theme-color> drives the
			     Android/Chrome status bar; a static value can't follow the
			     12 user-selectable themes (incl. custom ones via CSS vars).
			     Read the active theme's actual surface colour off the CSS
			     variables (dark themes carry the `dark` class) and write it
			     to the meta. Runs in <head> after the stylesheet + theme
			     class are applied (script is blocked on the preceding
			     stylesheet) so it lands before first paint — no flash — and a
			     MutationObserver re-syncs whenever the theme switcher swaps
			     the class on <html>. -->
			<script>
				(function () {
					function sync() {
						var h = document.documentElement;
						var isDark = h.classList.contains('dark');
						var triplet = getComputedStyle(h)
							.getPropertyValue(isDark ? '--color-navy-800' : '--color-white-100')
							.trim();
						if (!triplet) return;
						var meta = document.querySelector('meta[name="theme-color"]');
						if (!meta) {
							meta = document.createElement('meta');
							meta.setAttribute('name', 'theme-color');
							document.head.appendChild(meta);
						}
						meta.setAttribute('content', 'rgb(' + triplet.split(/\s+/).join(',') + ')');
					}
					sync();
					new MutationObserver(sync).observe(document.documentElement, {
						attributes: true,
						attributeFilter: ['class'],
					});
					window.addEventListener('DOMContentLoaded', sync);
				})()
			</script>
			<!-- Themed native scrollbars (code blocks, overflow panels) so
			     they match the cream / navy palette instead of the OS default.
			     WebKit pseudo-elements cover Chromium/Safari/Electron; the
			     scrollbar-* shorthands cover Firefox. Track stays transparent
			     to blend into whatever surface the scroll container sits on. -->
			<style>
				/* How much page chrome sits above the viewport's content —
				   0 unless the impersonation banner is rendered, which then
				   measures itself into this. Anything sized to the whole
				   viewport subtracts it. */
				:root { --wick-chrome-top: 0px; }
				* { scrollbar-width: thin; scrollbar-color: #cfc9b8 transparent; }
				.dark * { scrollbar-color: #2c3a5a transparent; }
				*::-webkit-scrollbar { width: 10px; height: 10px; }
				*::-webkit-scrollbar-track { background: transparent; }
				*::-webkit-scrollbar-thumb {
					background: #cfc9b8;
					border-radius: 999px;
					border: 2px solid transparent;
					background-clip: padding-box;
				}
				*::-webkit-scrollbar-thumb:hover { background: #b9b29d; background-clip: padding-box; border: 2px solid transparent; }
				.dark *::-webkit-scrollbar-thumb { background: #2c3a5a; background-clip: padding-box; }
				.dark *::-webkit-scrollbar-thumb:hover { background: #3d4f74; background-clip: padding-box; }
				*::-webkit-scrollbar-corner { background: transparent; }
			</style>
		</head>
		<body>
			@impersonationBanner(ImpersonationFromContext(ctx))
			{ children... }
			@Palette()
			@Dialog()
			<script src="/public/js/app.js"></script>
			<script src="/public/js/palette.js"></script>
			<script src="/public/js/dialog.js"></script>
			<script src="/public/js/push.js"></script>
			<script>
				if ('serviceWorker' in navigator) {
					window.addEventListener('load', function () {
						navigator.serviceWorker.register('/sw.js').catch(function () {})
					})
				}
			</script>
			<!-- Dev-only: live-disk hot reload. Empty string in production. -->
			@templ.Raw(spa.DevReloadScript())
		</body>
	</html>
}

// htmlThemeClasses returns the class attribute for the root element
// given a resolved theme. Empty theme is rendered by the inline script
// in <head> before first paint.
func htmlThemeClasses(t Theme) string {
	if t.ID == "" {
		return ""
	}
	if t.IsDark {
		return t.ClassName + " dark"
	}
	return t.ClassName
}

// impersonationBanner warns an admin that the session they are looking at is
// someone else's, and gives them the way back.
//
// Rendered above everything on every page: an admin who forgets they switched
// reads every permission and every empty list wrong. cau-* (caution), not
// neg-*, because nothing is broken — the state is just easy to misread.
templ impersonationBanner(info ImpersonationInfo) {
	if info.Active {
		<div data-chrome-banner class="flex flex-col gap-3 border-b border-cau-400 bg-cau-100 px-6 py-3 text-sm text-cau-400 sm:flex-row sm:items-center sm:justify-between">
			<span class="font-medium">
				Viewing as { info.ActingAs } — actions you take are recorded as this user.
			</span>
			<div class="flex shrink-0 items-center gap-2">
				<form action="/admin/impersonate/stop" method="POST">
					<button type="submit" class="inline-flex items-center justify-center rounded-lg border border-cau-400 bg-white-100 px-3 py-2 text-xs font-medium text-cau-400 transition-colors hover:bg-white-200 dark:bg-navy-700">
						Back to my account
					</button>
				</form>
				<!-- Hiding it is not dismissing it. The state this warns about
				     outlives the page, so the warning cannot simply be closed —
				     but the thing it must not take with it is the way OUT. That
				     now lives in the account menu (a caution dot on the avatar,
				     "Viewing as …" + "Back to my account" inside), which is
				     chrome that is always on screen and can't be collapsed. -->
				<button
					type="button"
					data-chrome-banner-hide
					title="Collapse this bar — 'Back to my account' stays in your account menu"
					aria-label="Collapse the viewing-as bar"
					class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-cau-400/40 text-cau-400 transition-colors hover:bg-white-200 dark:hover:bg-navy-700"
				>
					<svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
						<path d="M4 6l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</button>
			</div>
		</div>
		<!-- The banner sits ABOVE every page in normal flow, so a page sized to
		     the whole viewport (the agents shell is 100svh) ends up one banner
		     too tall and loses its bottom edge off-screen — the conversation
		     composer and the inbox list were cut off while viewing as someone
		     else. It cannot be a fixed number: the row wraps to two lines on a
		     narrow window and a long display name changes where. So the banner
		     publishes its own measured height and full-height shells subtract
		     it. -->
		<script>
			(function () {
				var el = document.querySelector('[data-chrome-banner]');
				if (!el) return;
				var hide = document.querySelector('[data-chrome-banner-hide]');
				var KEY = 'wick.impersonation-banner.collapsed';
				var publish = function (collapsed) {
					// Collapsed contributes no height: a full-height shell
					// subtracting a hidden banner loses its bottom edge.
					var h = collapsed ? 0 : el.offsetHeight;
					document.documentElement.style.setProperty('--wick-chrome-top', h + 'px');
				};
				// The banner is server-rendered on every page, so the choice
				// has to be remembered here or it comes back on every click.
				//
				// Hiding is done with `display`, NOT the `hidden` property:
				// Tailwind's preflight writes [hidden] inside :where(), which
				// has zero specificity, so the element's own `flex`/`fixed`
				// utility wins and `el.hidden = true` changes nothing visible.
				// The bar stayed on screen while this code believed it was
				// gone — and then published a 0px chrome height for a banner
				// that was still taking up room, which is what pushed every
				// full-height shell (sidebar footer, composer) off the bottom
				// of the screen while viewing as someone else.
				var collapsedNow = false;
				var apply = function (collapsed) {
					collapsedNow = collapsed;
					el.style.display = collapsed ? 'none' : '';
					publish(collapsed);
				};
				var stored = false;
				try { stored = window.localStorage.getItem(KEY) === '1'; } catch (e) {}
				apply(stored);
				if (hide) hide.addEventListener('click', function () {
					try { window.localStorage.setItem(KEY, '1'); } catch (e) {}
					apply(true);
				});
				// Re-measure on resize/wrap, but never let the observer
				// republish a height for a bar the user collapsed.
				var remeasure = function () { publish(collapsedNow); };
				if (window.ResizeObserver) new ResizeObserver(remeasure).observe(el);
				else window.addEventListener('resize', remeasure);
			})();
		</script>
	}
}
