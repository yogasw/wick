package ui

import "time"

// TimeFormat picks how an instant reads once it is in front of someone.
// The Go layout and the browser's re-render are chosen together from
// this one value, so a server-rendered fallback and a localized value
// can never drift into two different shapes.
type TimeFormat string

const (
	TimeFormatDate     TimeFormat = "date"     // Sep 2, 2026
	TimeFormatDateTime TimeFormat = "datetime" // Sep 2, 2026 15:04
	TimeFormatISO      TimeFormat = "iso"      // 2026-09-02 15:04
)

// LocalTime renders an instant in the READER's timezone.
//
// Wick renders pages server-side, so a timestamp formatted in Go comes
// out in the timezone of the machine wick runs on. On a host in Jakarta
// that means every "Last used" reads WIB — with nothing on screen
// saying so — no matter where the person looking at it is sitting. The
// chat already gets this right because it formats message times in the
// browser; this is the same thing for the server-rendered pages.
//
// The instant goes in the datetime attribute (RFC3339, offset
// included), and the element's text is the server-side rendering. JS
// rewrites it into the viewer's own zone on load; with JS off the
// fallback is exactly what the page showed before. See
// web/public/js/app.js.
templ LocalTime(t time.Time, f TimeFormat) {
	<time datetime={ t.Format(time.RFC3339) } data-local={ string(f) }>{ t.Format(goLayout(f)) }</time>
}

// goLayout is the server-side twin of the browser formatter in app.js.
// Change one, change the other.
func goLayout(f TimeFormat) string {
	switch f {
	case TimeFormatDate:
		return "Jan 2, 2006"
	case TimeFormatISO:
		return "2006-01-02 15:04"
	default:
		return "Jan 2, 2006 15:04"
	}
}
