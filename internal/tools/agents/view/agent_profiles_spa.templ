package view

// AgentProfilesSPAVM feeds the thin shell that hosts the sub-agent roles
// SPA inside the standard agents layout. AssetURL is the hashed Vite
// bundle path resolved at boot via spaAssetURL("agent-profiles").
type AgentProfilesSPAVM struct {
	Layout   AgentsLayoutVM
	Base     string
	AssetURL string
}

// AgentProfilesSPA renders the sub-agent roles shell. The SPA reads
// data-base from the #app div and uses it as the prefix for all API calls
// (e.g. ${base}/api/agent-profiles).
templ AgentProfilesSPA(vm AgentProfilesSPAVM) {
	@AgentsLayout(vm.Layout) {
		if vm.AssetURL == "" {
			<div class="p-8 text-sm text-rose-600 dark:text-rose-400">
				Sub-agents bundle not built yet. Run
				<code class="font-mono">npm --workspace=@wick-fe/agents-agent-profiles run build</code>
				in <code class="font-mono">fe/</code> and refresh.
			</div>
		} else {
			<div
				id="app"
				data-base={ vm.Base }
				class="h-full"
			></div>
			<script type="module" src={ vm.AssetURL }></script>
		}
	}
}
