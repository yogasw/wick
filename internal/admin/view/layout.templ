package view

import (
	"github.com/yogasw/wick/internal/entity"
	"github.com/yogasw/wick/internal/pkg/ui"
)

templ AdminLayout(title string, activeTab string, user *entity.User) {
	@ui.Layout(title) {
		<nav class="sticky top-0 z-50 flex min-h-16 items-center border-b border-white-300 dark:border-navy-600 bg-white-100 dark:bg-navy-700 shadow-sm">
			<div class="mx-auto flex w-full max-w-container flex-wrap items-center justify-between md:justify-start gap-x-4 gap-y-3 px-6 py-3 md:py-0">
				<div class="flex items-center gap-2 min-w-0">
					<a href="/" class="inline-flex items-center gap-2 text-base font-semibold text-black-900 dark:text-white-100">
						<span class="inline-block h-2 w-2 rounded-full bg-green-500"></span>
						{ ui.AppNameFromContext(ctx) }
					</a>
					<span class="text-black-600 dark:text-black-700">/</span>
					<span class="flex items-center gap-1.5 text-sm font-medium text-black-800 dark:text-black-600">
						<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z"/>
							<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
						</svg>
						Admin
					</span>
				</div>
				<div class="flex flex-wrap items-center gap-1 rounded-lg border border-white-300 dark:border-navy-600 bg-white-200 dark:bg-navy-800 p-1 order-last w-full md:order-none md:w-auto md:mr-auto">
					@adminTab("/admin", "Dashboard", activeTab == "dashboard")
					@adminTab("/admin/users", "Users", activeTab == "users")
					@adminDropdown("Mini Tools", isMiniToolsActive(activeTab), []dropdownItem{
						{Href: "/admin/tools", Label: "Tools", Active: activeTab == "tools"},
						{Href: "/admin/connectors", Label: "Connectors", Active: activeTab == "connectors"},
						{Href: "/admin/jobs", Label: "Jobs", Active: activeTab == "jobs"},
						{Href: "/mini-tools", Label: "Mini Tools", Active: false},
					})
					@adminDropdown("Agents", isAgentsActive(activeTab), []dropdownItem{
						{Href: "/admin/projects", Label: "Projects", Active: activeTab == "projects"},
						{Href: "/admin/schedule", Label: "Schedules", Active: activeTab == "schedule"},
						{Href: "/admin/workflows", Label: "Workflows", Active: activeTab == "workflows"},
						{Href: "/admin/skills", Label: "Skills", Active: activeTab == "skills"},
						{Href: "/admin/data-tables", Label: "Data Tables", Active: activeTab == "data-tables"},
						{Href: "/admin/providers", Label: "Providers", Active: activeTab == "providers"},
					})
					@adminDropdown("Access", isAccessActive(activeTab), []dropdownItem{
						{Href: "/admin/access-tokens", Label: "Access Tokens", Active: activeTab == "access-tokens"},
						{Href: "/admin/connections", Label: "Connected Apps", Active: activeTab == "connections"},
					})
					@adminDropdown("Setup", isSetupActive(activeTab), []dropdownItem{
						{Href: "/admin/advanced", Label: "Advanced", Active: activeTab == "advanced"},
						{Href: "/admin/tags", Label: "Tags", Active: activeTab == "tags"},
					})
				</div>
				<div class="flex items-center gap-3 ml-auto md:order-last md:ml-0">
					<button
						onclick="toggleDark()"
						aria-label="Toggle dark mode"
						class="flex h-9 w-9 items-center justify-center rounded-lg border border-white-400 dark:border-navy-600 bg-white-200 dark:bg-navy-800 text-black-800 dark:text-black-600 hover:border-green-400 transition-colors"
					>
						<span class="dark:hidden">🌙</span>
						<span class="hidden dark:inline">☀️</span>
					</button>
					@ui.UserMenu(user, false)
				</div>
			</div>
		</nav>
		@pendingSwapBanner()
		{ children... }
		@AccessModalHost()
		<script src="/modules/admin/js/tag_picker.js"></script>
		<!-- Background save for every tag form on these pages: the Save
		     button shows only while a row differs from the server, so a
		     long tagging session never has to guess what it missed. -->
		<script src="/modules/admin/js/tag_form.js"></script>
		<!-- Access reach badges, their user modal, and the per-page search. -->
		<script src="/modules/admin/js/access.js"></script>
	}
}

// pendingSwapBanner sits under the nav on EVERY admin page and stays hidden
// until a build is installed (or staged) but not yet running. That state is
// invisible otherwise — the app looks perfectly normal while the version an
// operator thinks they deployed is not the one answering — so it is worth a
// line at the top of whatever page they happen to be on, not just the
// Software Update screen.
//
// Filled by polling the same endpoint the Software Update page uses. Hidden
// on that page, where the full card already says all of this.
templ pendingSwapBanner() {
	<div id="wick-swap-banner" class="hidden border-b border-amber-300 dark:border-amber-700 bg-amber-50 dark:bg-navy-800">
		<div class="mx-auto flex w-full max-w-container flex-wrap items-center gap-x-3 gap-y-1 px-6 py-2 text-sm">
			<span id="wick-swap-banner-title" class="font-medium text-black-900 dark:text-white-100">Update waiting to be applied</span>
			<span id="wick-swap-banner-versions" class="font-mono text-xs text-black-900 dark:text-white-100"></span>
			<span id="wick-swap-banner-waiting" class="font-mono text-xs text-black-700 dark:text-black-600"></span>
			<span id="wick-swap-banner-error" class="hidden font-mono text-xs text-neg-400"></span>
			<span id="wick-swap-banner-auto" class="text-xs text-black-800 dark:text-black-600"></span>
			<a href="/admin/advanced/software-update" class="ml-auto text-xs font-medium text-green-600 dark:text-green-400 hover:underline">Details →</a>
		</div>
	</div>
	<script type="text/javascript">
	(function () {
		var el = document.getElementById('wick-swap-banner');
		if (!el) return;
		// The Software Update page renders the full card, so the banner keeps
		// quiet there. Checked when rendering, NOT here: this script lives in
		// the layout and runs before the page body is parsed, so looking for
		// #sys-live at this point always missed it — which is why the banner
		// followed you onto the detail page.
		function onDetailPage() { return !!document.getElementById('sys-live'); }
		var titleEl = document.getElementById('wick-swap-banner-title');
		var versionsEl = document.getElementById('wick-swap-banner-versions');
		var waitingEl = document.getElementById('wick-swap-banner-waiting');
		var errorEl = document.getElementById('wick-swap-banner-error');
		var autoEl = document.getElementById('wick-swap-banner-auto');
		var autoState = '', autoLeft = 0, autoElapsed = 0;
		function mmss(n) {
			if (n < 60) return n + 's';
			return Math.floor(n / 60) + 'm' + String(n % 60).padStart(2, '0') + 's';
		}
		function autoText() {
			switch (autoState) {
				case 'settling': return '· swapping automatically in ' + mmss(autoLeft);
				case 'waiting': return '· will swap once this process is idle';
				case 'previous_draining': return '· previous process still finishing, retrying in ' + mmss(autoLeft);
				case 'handing_over': return '· handing over — the new process is booting (' + mmss(autoElapsed) + ', abort limit ' + mmss(autoLeft) + ')';
			}
			return '';
		}
		function handingOver() { return autoState === 'handing_over'; }
		function paintAuto() {
			if (autoEl) autoEl.textContent = autoText();
			// Same two titles the Software Update card uses. A banner still
			// saying "waiting to be applied" while the successor is already
			// booting describes a state that has passed.
			if (titleEl) titleEl.textContent = handingOver() ? 'Swapping to the new build' : 'Update waiting to be applied';
		}
		setInterval(function () {
			if (autoState === 'handing_over') autoElapsed++;
			if (autoLeft > 0) autoLeft--;
			if (autoState !== '') paintAuto();
		}, 1000);
		function render(d) {
			var sw = d && d.swap;
			var pending = !!(sw && sw.pending) && !onDetailPage();
			// Nothing waiting → the banner disappears. A successful swap needs
			// no announcement: the thing it was warning about is gone.
			el.classList.toggle('hidden', !pending);
			if (!pending) return;
			if (versionsEl) versionsEl.textContent = (sw.from || '—') + '  →  ' + (sw.to || '—');
			autoState = (d.auto_swap && d.auto_swap.state) || '';
			autoElapsed = (d.auto_swap && d.auto_swap.elapsed_seconds) || 0;
			autoLeft = handingOver()
				? ((d.auto_swap && d.auto_swap.gives_up_in_seconds) || 0)
				: ((d.auto_swap && d.auto_swap.next_check_in) || 0);
			if (waitingEl) {
				// The idle gate is what the swap is waiting ON, so it has
				// nothing to say once the successor is booting — printing
				// "nothing running, it would swap straight away" next to a
				// handover already in flight reads as a swap that never
				// started.
				var busy = (d.busy_label && d.busy_label.length) ? d.busy_label : (d.busy || []);
				waitingEl.textContent = handingOver()
					? ''
					: (busy.length
						? '· waiting for ' + busy.join(', ')
						: '· nothing running — it would swap straight away');
			}
			paintAuto();
			// A handover that was attempted and failed leaves the old process
			// serving, which looks exactly like no attempt at all — worth a
			// line. But only while it is still the last word: once a new
			// handover is under way, or the retry is being counted down, the
			// live state says it better, and a red "last attempt failed"
			// beside it reads as THIS attempt failing.
			var lh = d.last_handover;
			if (errorEl) {
				var superseded = handingOver() || autoState === 'previous_draining';
				var failed = !!(lh && lh.ok === false && lh.error) && !superseded;
				errorEl.classList.toggle('hidden', !failed);
				if (failed) errorEl.textContent = '· last attempt failed: ' + lh.error;
			}
		}
		// Polled, not rendered once: a build can land at any moment — from the
		// CLI, from a deploy script — and the banner should appear on a page
		// that has been open the whole time, without anyone reloading it.
		// Realtime, the same stream the detail page uses; the poll stays as a
		// fallback for a browser or proxy that cannot hold it open.
		var streamOK = false;
		try {
			var es = new EventSource('/admin/advanced/software-update/serving/stream');
			es.addEventListener('serving', function (e) {
				try { streamOK = true; render(JSON.parse(e.data)); } catch (_) {}
			});
			es.onerror = function () { streamOK = false; };
		} catch (_) { /* no EventSource — the poll covers it */ }

		(function poll() {
			fetch('/admin/advanced/software-update/serving', { cache: 'no-store' })
				.then(function (r) { return r.ok ? r.json() : null; })
				.then(function (d) {
					if (d && !streamOK) render(d);
					setTimeout(poll, streamOK ? 15000 : 5000);
				})
				.catch(function () { setTimeout(poll, 15000); });
		})();
	})();
	</script>
}

templ adminTab(href string, label string, active bool) {
	<a
		href={ templ.SafeURL(href) }
		class={ "rounded-md px-4 py-2 text-sm font-medium transition-colors",
			templ.KV("bg-white-100 dark:bg-navy-700 text-black-900 dark:text-white-100 shadow-sm", active),
			templ.KV("text-black-800 dark:text-black-600 hover:text-black-900 dark:hover:text-white-100", !active) }
	>{ label }</a>
}

type dropdownItem struct {
	Href   string
	Label  string
	Active bool
}

func isMiniToolsActive(tab string) bool {
	return tab == "tools" || tab == "connectors" || tab == "jobs"
}

func isAgentsActive(tab string) bool {
	return tab == "projects" || tab == "schedule" || tab == "workflows" || tab == "skills" ||
		tab == "data-tables" || tab == "providers"
}

func isAccessActive(tab string) bool {
	return tab == "access-tokens" || tab == "connections"
}

func isSetupActive(tab string) bool {
	return tab == "advanced" || tab == "tags"
}

templ adminDropdown(label string, active bool, items []dropdownItem) {
	<div class="relative">
		<details class="group">
			<summary
				class={ "flex cursor-pointer list-none items-center gap-1 rounded-md px-4 py-2 text-sm font-medium transition-colors focus:outline-none",
					templ.KV("bg-white-100 dark:bg-navy-700 text-black-900 dark:text-white-100 shadow-sm", active),
					templ.KV("text-black-800 dark:text-black-600 hover:text-black-900 dark:hover:text-white-100", !active) }
			>
				{ label }
				<svg class="h-3 w-3 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"/>
				</svg>
			</summary>
			<div class="absolute left-0 top-full mt-2 w-48 rounded-xl border border-white-300 dark:border-navy-600 bg-white-100 dark:bg-navy-700 shadow-lg z-50 py-1">
				for _, it := range items {
					<a
						href={ templ.SafeURL(it.Href) }
						class={ "block px-4 py-2 text-sm transition-colors",
							templ.KV("bg-white-200 dark:bg-navy-800 text-black-900 dark:text-white-100 font-medium", it.Active),
							templ.KV("text-black-800 dark:text-black-600 hover:bg-white-200 dark:hover:bg-navy-800 hover:text-black-900 dark:hover:text-white-100", !it.Active) }
					>{ it.Label }</a>
				}
			</div>
		</details>
	</div>
}
