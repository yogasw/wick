package view

import "github.com/yogasw/wick/internal/entity"

// PluginsSPAVM hosts the manager SPA's plugins view in the admin chrome.
// AssetURL + Base come from manager.SPAMount(): the same bundle /manager
// serves, with its router still rooted at /manager so API calls resolve.
type PluginsSPAVM struct {
	AssetURL string
	Base     string
}

// PluginsPage is a thin shell: data-embed="plugins" tells the manager entry
// to mount only the plugins view (no manager navbar or breadcrumbs).
templ PluginsPage(vm PluginsSPAVM, user *entity.User) {
	@AdminLayout("Admin · Plugins", "plugins", user) {
		<main class="mx-auto w-full max-w-container px-6 py-8">
			@pluginsTabs("plugins")
			if vm.AssetURL == "" {
				<div class="text-sm text-neg-400">
					Manager bundle not built yet. Run
					<code class="font-mono">npm --workspace=@wick-fe/manager run build</code>
					in <code class="font-mono">fe/</code> and refresh.
				</div>
			} else {
				<div id="app" data-base={ vm.Base } data-embed="plugins"></div>
				<script type="module" src={ vm.AssetURL }></script>
			}
		</main>
	}
}

// pluginsTabs switches between the installed-plugins view and the
// development-mode page (plugin test requests) under Admin → Plugins.
templ pluginsTabs(active string) {
	<nav class="mb-6 flex gap-1 border-b border-white-300 dark:border-navy-600 text-sm">
		@pluginsTab("/admin/plugins", "Plugins", active == "plugins")
		@pluginsTab("/admin/plugins/dev-mode", "Development mode", active == "dev-mode")
	</nav>
}

templ pluginsTab(href, label string, on bool) {
	if on {
		<a href={ templ.SafeURL(href) } class="-mb-px border-b-2 border-green-600 px-4 py-2 font-medium text-black-900 dark:text-white-100">{ label }</a>
	} else {
		<a href={ templ.SafeURL(href) } class="-mb-px border-b-2 border-transparent px-4 py-2 text-black-700 dark:text-black-600 hover:text-black-900 dark:hover:text-white-100">{ label }</a>
	}
}
