package view

import (
	"github.com/yogasw/wick/internal/entity"
	"strings"
)

templ ConnectorsAdminPage(rows []ConnectorAdminRow, allTags []*entity.Tag, users []UserOption, user *entity.User) {
	@AdminLayout("Admin · Connectors", "connectors", user) {
		{{ tagsJSON := tagsToJSON(allTags) }}
		<main class="mx-auto w-full max-w-container px-6 py-8">
			<h1 class="text-[1.375rem] font-semibold text-black-900 dark:text-white-100">Connector Instances</h1>
			<p class="mt-1 text-sm text-black-800 dark:text-black-600">Every connector row across all definitions, with the OAuth accounts connected to each one listed underneath. Owner is the person who administers the instance — they configure it and see every account connected to it. Access tags gate which non-admin users can see it. Turning an instance off lives on its settings page, not here. A connected account is private to the user who connected it — tag the account to share that one identity with a team, or turn on &#34;Others can see connected accounts&#34; in the instance&#39;s Access policy to share the whole pool. Edit credentials and operations on the per-instance settings page.</p>
			if len(rows) == 0 {
				<div class="mt-6 rounded-xl border border-white-300 dark:border-navy-600 bg-white-100 dark:bg-navy-700 p-8 text-center text-sm text-black-700 dark:text-black-600">
					No connector instances yet. They are auto-seeded for every code-registered connector on first boot.
				</div>
			} else {
				@AccessSearch("connectors")
				<div class="mt-6 overflow-visible rounded-xl border border-white-300 dark:border-navy-600 bg-white-100 dark:bg-navy-700 shadow-sm resp-table-wrap">
					<table class="w-full text-sm resp-table">
						<thead>
							<tr class="border-b border-white-300 dark:border-navy-600 bg-white-200 dark:bg-navy-800">
								<th class="px-4 py-3 text-left font-medium text-black-800 dark:text-black-600">Instance</th>
								<th class="px-4 py-3 text-left font-medium text-black-800 dark:text-black-600">Owner</th>
								<th class="px-4 py-3 text-left font-medium text-black-800 dark:text-black-600">Access</th>
								<th class="px-4 py-3 text-left font-medium text-black-800 dark:text-black-600">Tags</th>
								<th class="px-4 py-3 text-right font-medium text-black-800 dark:text-black-600"></th>
							</tr>
						</thead>
						<tbody>
							for _, row := range rows {
								@connectorAdminRowFragment(row, tagsJSON, users)
								for _, acc := range row.Accounts {
									@connectorAccountAdminRowFragment(row, acc, tagsJSON)
								}
							}
						</tbody>
					</table>
				</div>
			}
		</main>
	}
}

templ connectorAdminRowFragment(row ConnectorAdminRow, tagsJSON string, users []UserOption) {
	{{ id := row.Connector.ID }}
	{{ key := row.Connector.Key }}
	<tr
		id={ "connector-" + id }
		data-search={ searchHaystack(row.Connector.Label, id, key, row.ModuleName, strings.Join(row.TagNames, " ")) }
		data-search-id={ id }
		class={ "border-b border-white-300 dark:border-navy-600 last:border-0 hover:bg-white-200 dark:hover:bg-navy-800 transition-colors",
			templ.KV("opacity-60", row.Connector.Disabled) }
	>
		<td class="px-4 py-3">
			<div class="flex items-center gap-3">
				<div class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-green-200 dark:bg-green-800 text-xs font-semibold text-green-700 dark:text-green-300">
					if row.ModuleIcon != "" {
						{ row.ModuleIcon }
					} else {
						🔌
					}
				</div>
				<div>
					<p class="font-medium text-black-900 dark:text-white-100">
						{ row.Connector.Label }
						if row.Connector.Disabled {
							// The toggle moved to the instance settings page, but the
							// state has to stay readable here: an admin wondering why
							// a row is missing from MCP must not have to open it to
							// find out.
							<span class="ml-2 inline-flex items-center rounded-full bg-neg-100 px-2 py-0.5 text-[10px] font-medium text-neg-400 align-middle">Disabled</span>
						}
					</p>
					<p class="text-xs text-black-700 dark:text-black-600">
						if row.ModuleMissing {
							<span class="text-neg-400">Module not registered</span> ·
						} else if row.ModuleName != "" {
							{ row.ModuleName } ·
						}
						<span class="font-mono">{ key }</span>
					</p>
				</div>
			</div>
		</td>
		<td class="px-4 py-3 align-top">
			@connectorOwnerPicker(row, users)
		</td>
		<td class="px-4 py-3 align-top">
			@AccessBadge(row.Access)
		</td>
		<td class="px-4 py-3 align-top">
			<form action={ templ.SafeURL("/admin/connectors/" + id + "/tags") } method="POST" class="flex items-start gap-2">
				<div
					class="tag-picker w-full md:w-64"
					data-tags={ tagsJSON }
					data-selected={ strings.Join(row.TagIDs, ",") }
					data-can-create="true"
					data-disabled?={ row.Connector.Disabled }
				></div>
				<!-- Marker so the handler can tell "no tags selected" from "I could not read the body". -->
				<input type="hidden" name="tags_submitted" value="1"/>
				if !row.Connector.Disabled {
					<button type="submit" class="mt-1 text-xs font-medium text-green-600 hover:underline">Save</button>
				}
			</form>
		</td>
		<td class="px-4 py-3 text-right align-top">
			if !row.ModuleMissing {
				<a href={ templ.SafeURL("/manager/connectors/" + key + "/" + id) } title="Settings" class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-white-400 dark:border-navy-600 text-black-700 dark:text-black-600 hover:border-green-400 hover:text-green-600 transition-colors">
					<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z"/>
						<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
					</svg>
				</a>
			}
		</td>
	</tr>
}

// connectorAccountAdminRowFragment renders one connected OAuth account as a
// sub-row of its connector instance: who connected it, and its own tag
// picker. Tags on an account are the granular share — without one the
// account is only visible to its owner (and admins).
templ connectorAccountAdminRowFragment(row ConnectorAdminRow, acc ConnectorAccountAdminRow, tagsJSON string) {
	{{ id := row.Connector.ID }}
	{{ accID := acc.Account.ID }}
	<tr
		id={ "connector-account-" + accID }
		data-search={ searchHaystack(acc.Account.DisplayName, accID, acc.OwnerLabel, row.Connector.Label, strings.Join(acc.TagNames, " ")) }
		data-search-id={ accID }
		data-search-parent={ "connector-" + id }
		class={ "border-b border-white-300 dark:border-navy-600 last:border-0 bg-white-200/50 dark:bg-navy-800/40",
			templ.KV("opacity-60", row.Connector.Disabled) }
	>
		<td class="px-4 py-2.5">
			<div class="flex items-center gap-3 pl-11">
				<svg class="h-4 w-4 flex-shrink-0 text-black-700 dark:text-black-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
					<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
					<circle cx="12" cy="7" r="4"></circle>
				</svg>
				<div>
					<p class="font-medium text-black-900 dark:text-white-100">{ "@" + acc.Account.DisplayName }</p>
					// Why this account is reachable, next to the account itself.
					// The Owner column beside it now names the person who
					// connected it, so the two facts stop sharing one cell.
					<p class="mt-0.5">
						if row.Connector.AllowOthersSeeAccounts {
							<span class="inline-flex items-center rounded-full bg-white-300 dark:bg-navy-600 px-2 py-0.5 text-[10px] font-medium text-black-800 dark:text-black-600" title="This instance shares every connected account with anyone who can see it.">Pool shared</span>
						} else if len(acc.TagIDs) > 0 {
							<span class="inline-flex items-center rounded-full bg-pos-100 px-2 py-0.5 text-[10px] font-medium text-pos-400" title="Users carrying one of the tags on the right can see and run as this account.">Shared by tag</span>
						} else {
							<span class="inline-flex items-center rounded-full bg-white-300 dark:bg-navy-600 px-2 py-0.5 text-[10px] font-medium text-black-800 dark:text-black-600" title="Only the user who connected it, the instance owner and admins can see this account.">Private</span>
						}
					</p>
				</div>
			</div>
		</td>
		<td class="px-4 py-2.5 align-top">
			// An account has an owner of its own — the person who connected it
			// — and it is not the instance owner. It is read-only here: it is
			// recorded by the OAuth flow, and rewriting it would claim someone
			// authorised a grant they never did.
			if acc.OwnerLabel != "" {
				<span class="text-xs text-black-800 dark:text-black-600">connected by { acc.OwnerLabel }</span>
			} else {
				<span class="text-xs italic text-black-600 dark:text-black-700">no owner recorded</span>
			}
		</td>
		<td class="px-4 py-2.5 align-top">
			@AccessBadge(acc.Access)
		</td>
		<td class="px-4 py-2.5 align-top">
			<form action={ templ.SafeURL("/admin/connectors/" + id + "/accounts/" + accID + "/tags") } method="POST" class="flex items-start gap-2">
				<div
					class="tag-picker w-full md:w-64"
					data-tags={ tagsJSON }
					data-selected={ strings.Join(acc.TagIDs, ",") }
					data-can-create="true"
				></div>
				<!-- Marker so the handler can tell "no tags selected" from "I could not read the body". -->
				<input type="hidden" name="tags_submitted" value="1"/>
				<button type="submit" class="mt-1 text-xs font-medium text-green-600 hover:underline">Save</button>
			</form>
		</td>
		<td class="px-4 py-2.5 text-right align-top"></td>
	</tr>
}

// connectorOwnerPicker is the Owner cell. Ownership is not cosmetic on a
// connector: the owner is the non-admin who may configure the instance and
// who sees every account connected to it, so the name shown here answers
// "who do I ask" and the select answers "the person who used to own this has
// left". Save appears only once the selection changes.
templ connectorOwnerPicker(row ConnectorAdminRow, users []UserOption) {
	{{ owner := row.Connector.CreatedBy }}
	<form action={ templ.SafeURL("/admin/connectors/" + row.Connector.ID + "/owner") } method="POST" class="flex items-center gap-2">
		<select
			name="owner_user_id"
			data-initial={ owner }
			onchange="this.nextElementSibling.hidden = this.value === this.dataset.initial"
			class="min-w-0 w-44 rounded-lg border border-white-400 dark:border-navy-600 bg-white-200 dark:bg-navy-800 px-2 py-1 text-xs text-black-900 dark:text-white-100"
		>
			<option value="" selected?={ owner == "" }>system (no owner)</option>
			if owner != "" && !userOptionsHave(users, owner) {
				<option value={ owner } selected>{ row.OwnerLabel } — unknown user</option>
			}
			for _, u := range users {
				<option value={ u.ID } selected?={ owner == u.ID }>{ u.Label }</option>
			}
		</select>
		<button
			type="submit"
			hidden
			class="shrink-0 rounded-lg border border-green-400 bg-green-100 dark:bg-green-900 px-2 py-1 text-xs text-green-700 dark:text-green-300 hover:border-green-500 transition-colors"
		>Save</button>
	</form>
}
