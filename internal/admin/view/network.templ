package view

import "github.com/yogasw/wick/internal/entity"

func customDNSValue(dnsServers string) string {
	if dnsServers == "" || dnsServers == "8.8.8.8,8.8.4.4" || dnsServers == "1.1.1.1,1.0.0.1" {
		return ""
	}
	return dnsServers
}

templ NetworkPage(dnsServers string, user *entity.User) {
	@AdminLayout("Admin · Network & DNS", "advanced", user) {
		<main class="mx-auto w-full max-w-container px-6 py-8">
			<div class="flex items-center gap-2 text-sm text-black-700 dark:text-black-600">
				<a href="/admin/advanced" class="hover:text-green-600">Advanced</a>
				<span>/</span><span class="text-black-900 dark:text-white-100">Network & DNS</span>
			</div>
			<h1 class="mt-2 text-[1.375rem] font-semibold text-black-900 dark:text-white-100">Network & DNS</h1>
			<p class="mt-1 text-sm text-black-800 dark:text-black-600">Runtime network compatibility settings for connector plugins.</p>
			<form method="POST" action="/admin/advanced/network" class="mt-6 max-w-2xl rounded-xl border border-white-300 bg-white-100 p-6 shadow-sm dark:border-navy-600 dark:bg-navy-700">
				<label for="dns_provider" class="block text-sm font-medium text-black-900 dark:text-white-100">Termux plugin DNS provider</label>
				<p class="mt-1 text-xs text-black-700 dark:text-black-600">Used only by connector plugins running on Termux. Google DNS is the default.</p>
				<select id="dns_provider" name="dns_provider" class="mt-4 w-full rounded-lg border border-white-400 bg-white-100 px-3 py-2 text-sm text-black-900 outline-none focus:border-green-500 dark:border-navy-600 dark:bg-navy-800 dark:text-white-100">
					<option value="google" selected?={ dnsServers == "" || dnsServers == "8.8.8.8,8.8.4.4" }>Google DNS — 8.8.8.8 / 8.8.4.4</option>
					<option value="cloudflare" selected?={ dnsServers == "1.1.1.1,1.0.0.1" }>Cloudflare DNS — 1.1.1.1 / 1.0.0.1</option>
					<option value="custom" selected?={ dnsServers != "" && dnsServers != "8.8.8.8,8.8.4.4" && dnsServers != "1.1.1.1,1.0.0.1" }>Custom DNS</option>
				</select>
				<label for="dns_custom" class="mt-4 block text-sm font-medium text-black-900 dark:text-white-100">Custom DNS addresses</label>
				<p class="mt-1 text-xs text-black-700 dark:text-black-600">Used only when Custom DNS is selected. Enter 1–4 IP addresses separated by commas or spaces.</p>
				<input id="dns_custom" name="dns_custom" value={ customDNSValue(dnsServers) } placeholder="9.9.9.9,149.112.112.112" class="mt-2 w-full rounded-lg border border-white-400 bg-white-100 px-3 py-2 text-sm text-black-900 outline-none focus:border-green-500 dark:border-navy-600 dark:bg-navy-800 dark:text-white-100"/>
				<div class="mt-4 flex items-center gap-3">
					<button type="submit" class="rounded-lg bg-green-500 px-4 py-2 text-sm font-medium text-white-100 hover:bg-green-600">Save DNS settings</button>
					<span class="text-xs text-black-700 dark:text-black-600">Restart active plugin processes after changing this value.</span>
				</div>
			</form>
		</main>
	}
}
