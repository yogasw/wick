{
  "display_information": {
    "name": "Wick Personal Agent",
    "description": "AI agent bot powered by Wick",
    "background_color": "#1a1a2e"
  },
  "features": {
    "bot_user": {
      "display_name": "Wick Personal Agent",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "chat:write.customize",
        "reactions:write",
        "reactions:read",
        "usergroups:read",
        "channels:history",
        "groups:history",
        "im:history",
        "mpim:history",
        "assistant:write",
        "canvases:read",
        "canvases:write",
        "files:read",
        "files:write",
        "im:read",
        "im:write",
        "lists:read",
        "lists:write",
        "mpim:read",
        "users:read",
        "users:read.email"
      ]
    },
    "pkce_enabled": false
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.im",
        "message.mpim",
        "message.channels",
        "reaction_added",
        "reaction_removed",
        "assistant_thread_started",
        "message.groups"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://domain.com/api/slack"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false,
    "is_mcp_enabled": false
  }
}
